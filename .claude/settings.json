{
  "model": "opusplan",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws * create-*)",
      "Bash(aws * delete-*)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow run:*)",
      "Bash(aws ssm get-parameter*)",
      "Bash(aws ssm put-parameter*)",
      "Bash(aws ecs execute-command*)",
      "Bash(aws ssm start-session*)",
      "Bash(make demo-*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/filter-test-output.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
