    "agent-engineer": { "model": "sonnet", "effort": "medium", "maxTurns": 80 },
    "ai-engineer": { "model": "sonnet", "effort": "medium", "maxTurns": 80 },
    "payments-engineer": { "model": "sonnet", "effort": "medium", "maxTurns": 80 },
    "frontend": { "model": "sonnet", "effort": "medium", "maxTurns": 80 },
    "infra": { "model": "sonnet", "effort": "medium", "maxTurns": 60 },
    "test-runner": { "model": "sonnet", "effort": "low", "maxTurns": 15 }
