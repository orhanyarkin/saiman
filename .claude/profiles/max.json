{
  "name": "max",
  "description": "Max plan: more parallelism, stronger audits, one re-review on money paths.",
  "maxConcurrentSubagents": 3,
  "agents": {
    "architect": { "model": "opus", "effort": "high", "maxTurns": 40 },
