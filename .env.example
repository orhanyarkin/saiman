# Copy to .env and fill in. Never commit .env. Claude Code is blocked from reading it.

# --- LLM providers (the router picks per tier; see docs/ARCHITECTURE.md) ---
OPENAI_API_KEY=            # embeddings + tier0/tier1 chat. Containers read it from secrets/openai_api_key (ADR-0009 amendment), not from this file; keep a hard project limit at OpenAI
# MKK KAP API (ADR-0010): the base64 Basic credential lives in secrets/mkk_credentials, never here
GEMINI_API_KEY=            # tier1-premium Gemini 3.8 Flash
ANTHROPIC_API_KEY=         # tier2 Claude Sonnet 5 (batch). Console API billing, separate from your Claude subscription
DEEPSEEK_API_KEY=          # optional tier1 fallback, `public` data only (ADR-0003)

# --- Cost guards ---
LLM_DAILY_CAP_USD=0.70
LLM_RUN_TOKEN_BUDGET=60000
DEMO_REPLAY_WHEN_CAPPED=true

# --- x402 (TESTNET ONLY: Base Sepolia) ---
# The network (Base Sepolia, eip155:84532) and asset (test USDC) are fixed in the starter's code, not configurable (ADR-0008).
X402_FACILITATOR_URL=https://x402.org/facilitator   # public testnet facilitator, free, no API key
X402_SELLER_PAYTO_ADDRESS=       # REQUIRED for `make up`: public 0x address that receives test USDC (`cast wallet new`, keep only the address here)
X402_BUYER_PRIVATE_KEY=          # throwaway testnet wallet only; used by the console buyer (M1) and the orchestrator (M3+), never by seller-api (ADR-0009)
# M3: spend limits are config in deploy/compose (saiman.orchestrator.spend.*, ADR-0013), not variables here. In compose the orchestrator's buyer key is NOT read from this file: it comes from the file secrets/x402_buyer_private_key (human-created, see README). Its other settings are fixed in deploy/compose; the optional `make research-run` knobs are the shell variables RUN_QUESTION / RUN_BUDGET_ATOMIC / ORCH_URL (no values here).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# M4: the ledger and orchestrator read the chain through saiman.chain.* (public Base Sepolia RPC, not a secret).
# Set in deploy/compose, not here; compose policy pins the host to sepolia.base.org:
# SAIMAN_CHAIN_RPC_URL=https://sepolia.base.org
# SAIMAN_CHAIN_ALLOWED_HOSTS=sepolia.base.org
# The ledger's local `make recon-run` / `recon-report` / `ledger-balance` targets use LEDGER_URL (default http://localhost:8082).

# --- Infra ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/saiman
SPRING_DATASOURCE_USERNAME=saiman
SPRING_DATASOURCE_PASSWORD=saiman
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_DATA_REDIS_URL=redis://localhost:16380
# Host port for Valkey in deploy/compose; export it in your shell (compose doesn't read the repo-root .env).
# If you change it, change the port in SPRING_DATA_REDIS_URL above too.
VALKEY_HOST_PORT=16380
# OTLP over HTTP (port 4318, not gRPC 4317). Spring Boot 4.1 maps this standard variable to
# management.opentelemetry.* and appends /v1/traces, /v1/metrics, /v1/logs per signal (ADR-0006).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
