{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payments.failed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "authorization",
    "amount",
    "payTo",
    "resource",
    "book",
    "finality",
    "reasonCode"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "eventId",
        "occurredAt",
        "producer",
        "correlationId"
      ],
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "pattern": "^[a-z][a-z-]{1,31}$"
        },
        "correlationId": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "authorization": {
      "type": "object",
      "required": [
        "network",
        "asset",
        "payer",
        "nonce",
        "validBefore"
      ],
      "additionalProperties": false,
      "properties": {
        "network": {
          "const": "eip155:84532"
        },
        "asset": {
          "const": "0x036CbD53842c5426634e7929541eC2318f3dCF7e"
        },
        "payer": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "validBefore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4102444799
        }
      }
    },
    "amount": {
      "type": "object",
      "required": [
        "atomicUnits",
        "asset",
        "decimals"
      ],
      "additionalProperties": false,
      "properties": {
        "atomicUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "asset": {
          "const": "USDC"
        },
        "decimals": {
          "const": 6
        }
      }
    },
    "payTo": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "book": {
      "enum": [
        "BUYER",
        "SELLER"
      ]
    },
    "finality": {
      "enum": [
        "FINAL",
        "AMBIGUOUS"
      ]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
    },
    "paymentIntentId": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
