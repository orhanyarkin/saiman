{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent.run-step.v1",
  "description": "Envelope of one run step as sent over SSE and returned by the JSON export of GET /api/v1/runs/{runId}/events.",
  "type": "object",
  "required": [
    "eventId",
    "runId",
    "seq",
    "type",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}:[1-9][0-9]*$"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "RUN_STARTED",
        "STEP_STARTED",
        "STEP_COMPLETED",
        "PLAN_CREATED",
        "TOOL_CALL_REQUESTED",
        "PAYMENT_APPROVAL_REQUIRED",
        "PAYMENT_APPROVAL_DECIDED",
        "PAYMENT_DENIED",
        "PAYMENT_SETTLED",
        "PAYMENT_AMBIGUOUS",
        "TOOL_CALL_COMPLETED",
        "MODEL_CALL_COMPLETED",
        "RUN_COMPLETED",
        "RUN_FAILED"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "RUN_STARTED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "budget"
          ],
          "properties": {
            "question": {
              "type": "string"
            },
            "budget": {
              "$ref": "#/$defs/Money"
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "STEP_STARTED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step"
          ],
          "properties": {
            "step": {
              "enum": [
                "PLANNER",
                "RESEARCHER",
                "RISK",
                "SYNTHESIS"
              ]
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "STEP_COMPLETED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step"
          ],
          "properties": {
            "step": {
              "enum": [
                "PLANNER",
                "RESEARCHER",
                "RISK",
                "SYNTHESIS"
              ]
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "PLAN_CREATED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tickers",
            "tasks"
          ],
          "properties": {
            "tickers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "TOOL_CALL_REQUESTED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "arguments"
          ],
          "properties": {
            "tool": {
              "type": "string"
            },
            "arguments": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "PAYMENT_APPROVAL_REQUIRED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvalId",
            "paymentIntentId",
            "amount",
            "payTo",
            "resource",
            "expiresAt"
          ],
          "properties": {
            "approvalId": {
              "type": "string",
              "format": "uuid"
            },
            "paymentIntentId": {
              "type": "string",
              "format": "uuid"
            },
            "amount": {
              "$ref": "#/$defs/Money"
            },
            "payTo": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "resource": {
              "type": "string"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "PAYMENT_APPROVAL_DECIDED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvalId",
            "decision"
          ],
          "properties": {
            "approvalId": {
              "type": "string",
              "format": "uuid"
            },
            "decision": {
              "enum": [
                "APPROVED",
                "REJECTED",
                "EXPIRED"
              ]
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "PAYMENT_DENIED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "amount"
          ],
          "properties": {
            "reason": {
              "enum": [
                "RUN_BUDGET",
                "DAILY_CAP",
                "PAYEE_NOT_ALLOWED",
                "OVER_PER_REQUEST_MAX",
                "UNKNOWN_INTENT",
                "APPROVAL_REJECTED",
                "APPROVAL_EXPIRED",
                "APPROVAL_MISMATCH",
                "OFFER_NOT_PAYABLE",
                "MAX_PAID_CALLS",
                "HOURLY_PAID_CALLS",
                "INVALID_ARGS"
              ]
            },
            "amount": {
              "$ref": "#/$defs/Money"
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "PAYMENT_SETTLED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paymentIntentId",
            "amount",
            "txHash"
          ],
          "properties": {
            "paymentIntentId": {
              "type": "string",
              "format": "uuid"
            },
            "amount": {
              "$ref": "#/$defs/Money"
            },
            "txHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "PAYMENT_AMBIGUOUS"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paymentIntentId",
            "amount"
          ],
          "properties": {
            "paymentIntentId": {
              "type": "string",
              "format": "uuid"
            },
            "amount": {
              "$ref": "#/$defs/Money"
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "TOOL_CALL_COMPLETED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "paid",
            "citationCount"
          ],
          "properties": {
            "tool": {
              "type": "string"
            },
            "paid": {
              "type": "boolean"
            },
            "citationCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "MODEL_CALL_COMPLETED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "tier",
            "model",
            "inputTokens",
            "outputTokens",
            "costUsd"
          ],
          "properties": {
            "step": {
              "enum": [
                "PLANNER",
                "RESEARCHER",
                "RISK",
                "SYNTHESIS"
              ]
            },
            "tier": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "costUsd": {
              "$ref": "#/$defs/Money"
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "RUN_COMPLETED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "report",
            "cost"
          ],
          "properties": {
            "report": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "answer",
                "citations"
              ],
              "properties": {
                "answer": {
                  "type": "string"
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "chunkId",
                      "sourceUrl",
                      "title"
                    ],
                    "properties": {
                      "chunkId": {
                        "type": "string"
                      },
                      "sourceUrl": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "cost": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "paymentsUsdc",
                "llmUsd",
                "totalUsd"
              ],
              "properties": {
                "paymentsUsdc": {
                  "$ref": "#/$defs/Money"
                },
                "llmUsd": {
                  "$ref": "#/$defs/Money"
                },
                "totalUsd": {
                  "$ref": "#/$defs/Money"
                }
              }
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "RUN_FAILED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failureCode",
            "costSoFar"
          ],
          "properties": {
            "failureCode": {
              "type": "string",
              "pattern": "^[A-Z_]+$"
            },
            "costSoFar": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "paymentsUsdc",
                "llmUsd",
                "totalUsd"
              ],
              "properties": {
                "paymentsUsdc": {
                  "$ref": "#/$defs/Money"
                },
                "llmUsd": {
                  "$ref": "#/$defs/Money"
                },
                "totalUsd": {
                  "$ref": "#/$defs/Money"
                }
              }
            }
          }
        }
      },
      "required": [
        "type",
        "data"
      ]
    }
  ],
  "$defs": {
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomicUnits",
        "asset",
        "decimals"
      ],
      "properties": {
        "atomicUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "asset": {
          "enum": [
            "USDC",
            "USD"
          ]
        },
        "decimals": {
          "const": 6
        }
      }
    }
  }
}
