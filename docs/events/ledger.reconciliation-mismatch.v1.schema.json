{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger.reconciliation-mismatch.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "mismatchId",
    "reconciliationRunId",
    "paymentId",
    "kind"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "eventId",
        "occurredAt",
        "producer",
        "correlationId"
      ],
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,64}$"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "pattern": "^[a-z][a-z-]{1,31}$"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:_-]{0,64}$"
        }
      }
    },
    "mismatchId": {
      "type": "string",
      "format": "uuid"
    },
    "reconciliationRunId": {
      "type": "string",
      "format": "uuid"
    },
    "paymentId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "AMOUNT_MISMATCH",
        "PARTY_MISMATCH",
        "TX_NOT_FOUND",
        "TX_FAILED",
        "TX_NOT_FOR_AUTHORIZATION",
        "SETTLED_BUT_UNUSED",
        "UNUSED_BUT_SETTLED",
        "CONFLICTING_TX",
        "ENCUMBRANCE_NOT_CLEARED",
        "BOOKS_OPEN",
        "CONFLICTING_FACT"
      ]
    },
    "ledgerAmount": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "atomicUnits",
            "asset",
            "decimals"
          ],
          "additionalProperties": false,
          "properties": {
            "atomicUnits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "asset": {
              "type": "string",
              "pattern": "^[A-Z0-9]{2,10}$"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "chainAmount": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "atomicUnits",
            "asset",
            "decimals"
          ],
          "additionalProperties": false,
          "properties": {
            "atomicUnits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "asset": {
              "type": "string",
              "pattern": "^[A-Z0-9]{2,10}$"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "reportedTxHash": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "chainTxHash": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "adjustmentEntryId": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
