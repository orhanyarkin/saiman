{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger.entry-posted.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "entryId",
    "paymentId",
    "kind",
    "postings",
    "effectiveAt"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "eventId",
        "occurredAt",
        "producer",
        "correlationId"
      ],
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "pattern": "^[a-z][a-z-]{1,31}$"
        },
        "correlationId": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "entryId": {
      "type": "string",
      "format": "uuid"
    },
    "paymentId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "ENCUMBER",
        "SETTLE",
        "RELEASE",
        "SALE",
        "CREDIT_NOTE",
        "ADJUSTMENT",
        "REVERSAL",
        "LLM_USAGE"
      ]
    },
    "postings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account",
          "side",
          "amount"
        ],
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "side": {
            "enum": [
              "DEBIT",
              "CREDIT"
            ]
          },
          "amount": {
            "type": "object",
            "required": [
              "atomicUnits",
              "asset",
              "decimals"
            ],
            "additionalProperties": false,
            "properties": {
              "atomicUnits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "asset": {
                "type": "string",
                "pattern": "^[A-Z0-9]{2,10}$"
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18
              }
            }
          }
        }
      }
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
